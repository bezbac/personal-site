---
import type { ReactElement } from "react";
import Layout from "../layouts/Layout.astro";
---

<Layout breadcrumb={{ title: "uses", href: "#" }}>
  <div class="container relative">
    <p class="px-container">
      Here&apos;s a list of my favorite tools & applications. These are things I
      use profesionally or to maintain an organized digital life. For an always
      up to date version and details regarding configuration, see my{" "}
      <a
        target="_blank"
        class="link external"
        href="https://github.com/bezbac/dotfiles"
      >
        dotfiles
      </a>
      .
    </p>

    <p class="mt-4 px-container">
      Inspired by{" "}
      <a
        target="_blank"
        rel="noreferrer"
        class="link external"
        href="https://uses.tech"
      >
        uses.tech
      </a>
      . Last updated 2026-10-26.
    </p>

    <div
      class="mt-12 flex flex-col divide-y divide-neutral-910 dark:divide-neutral-310 lg:mt-20"
    >
      {
        (
          [
            {
              title: "Hardware",
              items: [
                { title: '14" MacBook Pro (M5 Max, 36GB RAM)', label: "work" },
                '14" MacBook Pro (M1 Pro, 16GB RAM)',
                "Mac Mini (M1, 16GB RAM)",
                "iPhone 17",
                { title: "Apple Magic Keyboard with Touch ID", label: "work" },
                { title: "Logitech M650 L", label: "work" },
                "Logitech MX Keys for Mac",
                "Logitech MX Master 3",
              ],
            },
            {
              title: "Development Tools",
              items: [
                ["Zed", "https://zed.dev"],
                ["WezTerm", "https://wezfurlong.org/wezterm/"],
                ["Zellij", "https://zellij.dev"],
                ["Helix", "https://helix-editor.com"],
                "ZSH",
                ["Opencode", "https://opencode.ai"],
                ["Atuin", "https://atuin.sh"],
                ["Zoxide", "https://github.com/ajeetdsouza/zoxide"],
                ["Sheldon", "https://github.com/rossmacarthur/sheldon"],
                ["Starship", "https://starship.rs"],
                ["Gitu", "https://github.com/altsem/gitu"],
              ],
            },
            {
              title: "Applications",
              items: [
                ["Raycast", "https://raycast.com"],
                ["Aerospace", "https://github.com/nikitabobko/AeroSpace"],
                "Safari",
                ["1Password", "https://1password.com"],
                ["Tailscale", "https://tailscale.com"],
                ["Homerow", "https://www.homerow.app"],
                ["Orbstack", "https://orbstack.dev"],
                ["Obsidian", "https://obsidian.md"],
                ["Linear", "https://linear.app"],
                ["Velja", "https://sindresorhus.com/velja"],
                ["Mela", "https://mela.app"],
                ["Spotify", "https://spotify.com"],
                ["NetNewsWire", "https://netnewswire.com"],
                ["GoodLinks", "http://Goodlinks.app"],
                ["Beeper", "https://www.beeper.com"],
                ["Anybox", "https://anybox.app"],
              ],
            },
          ] as const
        ).map(({ title, items }) => {
          return (
            <div class="flex py-4 px-container text-prose-normal">
              <h2 class="w-1/3 shrink-0 text-base font-normal">{title}</h2>
              <ul class="flex flex-wrap gap-3">
                {items.map((item) => {
                  const [name, url, label] = (() => {
                    if (typeof item === "object" && "title" in item) {
                      return [item.title, undefined, item.label] as const;
                    }

                    if (!Array.isArray(item)) {
                      return [item, undefined, undefined] as const;
                    }

                    return [...item, undefined] as [
                      string | ReactElement,
                      string,
                      undefined,
                    ];
                  })();

                  const content = url ? (
                    <a
                      target="_blank"
                      class="cursor-pointer"
                      rel="noreferrer"
                      href={url}
                    >
                      {name}
                      <div class="inline-block size-4 rotate-180 -ml-2 translate-y-[0.1875rem] -mr-0.5">
                        ⟀
                      </div>
                    </a>
                  ) : (
                    <>{name}</>
                  );

                  return (
                    <li class="group rounded border text-prose-normal border-neutral-820 py-0.5 px-3 text-sm dark:border-neutral-310 dark:bg-neutral-230 [&>span]:text-prose-subtle relative">
                      {content}
                      {label !== undefined && (
                        <div class="inline-flex -mr-2 ml-2 text-accent bg-neutral-310 rounded px-1 py-0.5 leading-none">
                          {label}
                        </div>
                      )}
                    </li>
                  );
                })}
              </ul>
            </div>
          );
        })
      }
    </div>
  </div>
</Layout>
